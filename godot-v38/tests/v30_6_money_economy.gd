extends SceneTree
const CURRENT_RELEASE = preload("res://tests/current_release.gd")
const MONEY:=preload("res://scripts/systems/money_rules.gd")
var errors:int=0
func check(ok:bool,label:String)->void:
 if ok:print("PASS v30.6: "+label)
 else:
  errors+=1
  push_error("FAIL v30.6: "+label)
func _initialize()->void:call_deferred("_run")
func _run()->void:
 check(MONEY.total(1,100,100)==20100,"denominations normalize to copper")
 check(MONEY.split_total(13245)=={"gold":1,"silver":32,"copper":45},"wallet splits exactly")
 check(MONEY.format_total(13245)=="1g  32s  45c","coins render gold silver copper")
 check(MONEY.total(9999999999,0,0)==MONEY.MAX_COPPER,"large wallets are clamped")
 check(MONEY.bonus_loot(4,"elder",true,55)>MONEY.bonus_loot(0,"normal",false,55),"boss coin bonus scales")
 check(MONEY.sell_value({"rarity":"Legendary","power":80})>MONEY.sell_value({"rarity":"Common","power":80}),"rarer gear sells for more")
 var scene:PackedScene=load("res://scenes/main.tscn")
 check(scene!=null,"game scene loads")
 if scene==null:quit(1);return
 var game:Node3D=scene.instantiate()
 root.add_child(game)
 await process_frame
 check(CURRENT_RELEASE.matches_project(game),"new version scene active")
 var profile:String=OS.get_environment("MOONFALL_TEST_PROFILE")
 if profile.is_empty() or not ProjectSettings.globalize_path("user://").begins_with(profile):
  check(false,"requires isolated test profile")
 else:
  game.call("_start_game","z")
  check(game.get("gold")==0 and game.get("silver")==0 and game.get("copper")==0,"fresh wallet empty")
  game.set("gold",8)
  game.set("silver",75)
  game.set("copper",49)
  check(game.call("_near_outpost_merchant"),"outpost merchant reachable from start")
  game.call("_menu_tab","Wallet")
  check("MOONFALL TREASURY" in game.get("menu_body").text,"Wallet page accessible in Raven Atlas")
  game.call("_wallet_action","wallet_buy_heal")
  check(game.get("gold")==6 and game.get("silver")==25 and game.get("copper")==49,"merchant deducts 2g50s exactly")
  check(int(game.get("materials").get("Healing Draught",0))==1,"merchant provides purchased supply")
  var gear:Array=game.get("gear_items")
  gear.append({"name":"Moon Fang","rarity":"Rare","power":20})
  var expected:int=MONEY.sell_value(gear[0])
  var original_total:int=MONEY.total(game.get("gold"),game.get("silver"),game.get("copper"))
  game.call("_wallet_action","wallet_sell:0")
  check(game.get("gear_items").is_empty() and MONEY.total(game.get("gold"),game.get("silver"),game.get("copper"))==original_total+expected,"selling equipment deposits correct value once")
  game.call("_wallet_action","wallet_sell:0")
  check(MONEY.total(game.get("gold"),game.get("silver"),game.get("copper"))==original_total+expected,"cannot sell same gear twice")
  var at:Vector3=game.get("player").global_position
  var before:int=MONEY.total(game.get("gold"),game.get("silver"),game.get("copper"))
  game.call("_create_coin_drop",at,1234)
  check(game.get("coin_drops").size()==1,"coin bundle created in world")
  game.call("_update_coin_drops",0.20)
  check(game.get("coin_drops").is_empty() and MONEY.total(game.get("gold"),game.get("silver"),game.get("copper"))==before+1234,"nearby coins auto-collected once")
  game.call("_create_coin_drop",at+Vector3(8,0,0),314)
  game.call("_save_game")
  var saved:Dictionary=game.call("_read_save")
  check(saved.get("schema")==2 and saved.get("silver")==game.get("silver") and saved.get("copper")==game.get("copper"),"schema-2 checkpoint stores coin denominations")
  check((saved.get("coin_drops",[]) as Array).size()==1,"checkpoint persists uncollected coin piles")
  game.call("_restore_data",saved)
  check(game.get("coin_drops").size()==1,"checkpoint restores coin piles")
  var legacy:Dictionary=saved.duplicate(true)
  legacy.erase("silver")
  legacy.erase("copper")
  legacy.erase("coin_drops")
  game.call("_restore_data",legacy)
  check(game.get("gold")==int(legacy["gold"]) and game.get("silver")==0 and game.get("copper")==0 and game.get("coin_drops").is_empty(),"old gold-only saves migrate without losing money")
  game.call("_start_game","nyra")
  check(game.get("gold")==0 and game.get("silver")==0 and game.get("copper")==0,"hero switching clears previous wallet")
 game.queue_free()
 if errors==0:print("MOONFALL v30.6 CURRENCY & MERCHANT PASS")
 quit(0 if errors==0 else 1)
