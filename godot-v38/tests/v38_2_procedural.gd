extends SceneTree
const GEN:=preload("res://scripts/systems/procedural_variants_v382.gd")
const FEEDBACK:=preload("res://scripts/systems/combat_feedback_v383.gd")
var failures:int=0
func check(ok:bool,label:String)->void:
 if ok:print("PASS procedural: "+label)
 else:
  failures+=1
  push_error("FAIL procedural: "+label)
func _initialize()->void:call_deferred("_run")
func _run()->void:
 check(GEN.FAMILIES.size()==11 and GEN.ROLES.size()==11,"family and combat role catalogs bounded")
 check(GEN.MODIFIERS.size()==11 and GEN.ELEMENTS.size()==11,"modifier and element catalogs bounded")
 check(GEN.ATTACKS.size()==12 and GEN.ARENAS.size()==11,"attack and arena catalogs bounded")
 var a:Dictionary=GEN.encounter(142,12)
 var b:Dictionary=GEN.encounter(142,12)
 check(a==b,"identical seed produces identical encounter")
 check(a["enemy"]["level"]==12 and a["boss"]["boss"],"enemy and boss metadata available")
 check(a["boss"]["phase_count"]>=2 and a["boss"]["phase_count"]<=4,"boss phases bounded")
 check(int(a["loot"]["power"])<=250,"loot power follows equipment limit")
 for seed in [-214748,0,1,42,999999]:
  for level in [-10,1,100,10000]:
   var e:Dictionary=GEN.enemy(seed,level)
   var l:Dictionary=GEN.loot(seed,level)
   check(int(e["level"])>=1 and int(e["level"])<=1000,"enemy level clamped "+str(seed)+":"+str(level))
   check(float(e["hp_scale"])<=20.0 and float(e["damage_scale"])<=12.0,"enemy stats bounded "+str(seed)+":"+str(level))
   check(int(l["power"])>=0 and int(l["power"])<=250,"loot bounded "+str(seed)+":"+str(level))
 check(GEN.combat_intent("skirmisher",8.0,1.0,true,true)=="pursue","melee enemy pursues from range")
 check(GEN.combat_intent("bruiser",1.4,1.0,true,true)=="attack","melee enemy attacks in range")
 check(GEN.combat_intent("bruiser",1.4,1.0,false,true)=="guard","melee attack cooldown guards")
 check(GEN.combat_intent("sniper",2.0,1.0,true,true)=="retreat","ranged enemy maintains minimum spacing")
 check(GEN.combat_intent("caster",10.0,1.0,false,true)=="strafe","ranged cooldown causes strafe")
 check(GEN.combat_intent("ambusher",2.0,0.8,false,true)=="strafe","healthy ambusher flanks on cooldown")
 check(GEN.combat_intent("ambusher",2.0,0.8,true,true)=="attack","ambusher attacks when ready")
 check(GEN.combat_intent("caster",10.0,1.0,true,false)=="reposition","ranged AI seeks line of sight")
 check(GEN.combat_intent("ambusher",8.0,0.1,true,true)=="retreat","injured agile enemy retreats")
 check(GEN.combat_intent("guardian",-50.0,99.0,true,true)=="attack","invalid distance and HP clamp safely")
 check(GEN.combat_intent("sniper",8.0,1.0,true,true)==GEN.combat_intent("sniper",8.0,1.0,true,true),"AI intent deterministic")
 check(is_equal_approx(FEEDBACK.recoil_degrees(0.0,false),0.0),"hit recoil ends at zero")
 check(is_equal_approx(FEEDBACK.recoil_degrees(-100.0,true),0.0),"negative recoil duration safely clamped")
 check(is_equal_approx(FEEDBACK.recoil_degrees(FEEDBACK.REACTION_SECONDS,false),9.0),"normal hits have bounded recoil")
 check(is_equal_approx(FEEDBACK.recoil_degrees(FEEDBACK.REACTION_SECONDS,true),14.0),"critical hits have stronger bounded recoil")
 check(is_equal_approx(FEEDBACK.recoil_degrees(1000.0,true),14.0),"critical recoil cannot exceed cap")
 check(FEEDBACK.recoil_degrees(FEEDBACK.REACTION_SECONDS*0.5,false)<FEEDBACK.recoil_degrees(FEEDBACK.REACTION_SECONDS,false),"hit recoil smoothly diminishes")
 check(FEEDBACK.recoil_degrees(FEEDBACK.REACTION_SECONDS*0.5,true)>FEEDBACK.recoil_degrees(FEEDBACK.REACTION_SECONDS*0.5,false),"critical recoil remains stronger through fade")
 check(is_equal_approx(FEEDBACK.attack_followthrough_degrees(0.0),0.0),"attack follow-through rests after arc")
 check(is_equal_approx(FEEDBACK.attack_followthrough_degrees(FEEDBACK.ATTACK_SWING_SECONDS),0.0),"attack follow-through begins at neutral")
 check(is_equal_approx(FEEDBACK.attack_followthrough_degrees(FEEDBACK.ATTACK_SWING_SECONDS*0.5),FEEDBACK.ATTACK_SWING_ANGLE),"attack follow-through reaches mid-arc peak")
 check(is_equal_approx(FEEDBACK.attack_followthrough_degrees(-100.0),0.0),"negative follow-through time clamps")
 check(is_equal_approx(FEEDBACK.attack_followthrough_degrees(1000.0),0.0),"large follow-through time clamps")
 check(FEEDBACK.boss_telegraph_transparency(0.0,1)>=0.05,"boss telegraph remains visible")
 check(FEEDBACK.boss_telegraph_transparency(1.25,3)<=0.29,"boss warning opacity is bounded")
 check(FEEDBACK.boss_telegraph_transparency(0.2,1)!=FEEDBACK.boss_telegraph_transparency(0.2,3),"later boss phases pulse at a different cadence")
 check(FEEDBACK.boss_telegraph_transparency(0.2,999)<=0.29,"invalid boss phase clamps safely")
 check(not FEEDBACK.warning_radius_changed(2.8,2.8),"unchanged telegraph radius skips mesh rebuild")
 check(FEEDBACK.warning_radius_changed(2.8,3.8),"boss phase resize updates geometry")
 check(not FEEDBACK.warning_radius_changed(2.8,2.8+0.000001),"tiny radius jitter ignored")
 # Ecology crowd scans use squared distance, preserving boundary behavior.
 var probe_a:=Vector3.ZERO
 var probe_near:=Vector3(3.0,0.0,4.0)
 var probe_far:=Vector3(5.01,0.0,0.0)
 check(probe_near.distance_squared_to(probe_a)<30.25,"herd ally inside 5.5 radius")
 check(probe_far.distance_squared_to(probe_a)>=25.0,"herd boundary excludes range above five")
 check(probe_near.distance_squared_to(probe_a)>=25.0,"herd strict range excludes exact boundary")
 check(probe_near.distance_squared_to(probe_a)<64.0,"player proximity inside eight")
 # Distance-squared targeting keeps the same strict radius and nearest-first semantics.
 var hit_origin:=Vector3.ZERO
 var hit_near:=Vector3(3.0,0.0,4.0)
 var hit_far:=Vector3(6.0,0.0,0.0)
 check(hit_near.distance_squared_to(hit_origin)<5.1*5.1,"target inside radius remains eligible")
 check(hit_near.distance_squared_to(hit_origin)>=5.0*5.0,"target at exact radius remains excluded")
 check(hit_near.distance_squared_to(hit_origin)<hit_far.distance_squared_to(hit_origin),"nearest target chosen by squared distance")
 check(hit_far.distance_squared_to(hit_origin)<6.1*6.1,"area spell within radius remains eligible")
 # Strict squared-range boundaries for native enemy pursuit, prey search and boss markers.
 var chase_origin:=Vector3.ZERO
 var prey_inside:=Vector3(3.0,0.0,4.0)
 var prey_outside:=Vector3(6.0,0.0,0.0)
 check(prey_inside.distance_squared_to(chase_origin)<5.8*5.8,"prey inside range is eligible")
 check(prey_outside.distance_squared_to(chase_origin)>=5.8*5.8,"prey outside range is excluded")
 check(prey_inside.distance_squared_to(chase_origin)>=5.0*5.0,"strict range excludes exact boundary")
 check(prey_inside.distance_squared_to(chase_origin)>16.0,"distant wildlife returns toward home")
 check(prey_inside.distance_squared_to(chase_origin)<64.0,"nearby targets block respawn by radius")
 var boss_mark:=Vector2(0.0,0.0)
 check(Vector2(2.7,0.0).distance_squared_to(boss_mark)<2.8*2.8,"boss strike includes points inside warning disk")
 check(Vector2(2.8,0.0).distance_squared_to(boss_mark)>=2.8*2.8,"boss strike excludes exact disk edge")
 print("MOONFALL v38.2 PROCEDURAL PASS" if failures==0 else "MOONFALL v38.2 PROCEDURAL FAIL")
 quit(0 if failures==0 else 1)
