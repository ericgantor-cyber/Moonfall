extends SceneTree
const Rhythm = preload("res://scripts/systems/combat_rhythm.gd")

func _init() -> void:
 assert(Rhythm.next_chain(1, 0.2) == 2)
 assert(Rhythm.next_chain(5, 0.2) == 1)
 assert(Rhythm.next_chain(2, 0.49) == 1)
 assert(Rhythm.next_chain(3, NAN) == 1)
 assert(not Rhythm.chain_expired(0, 10.0))
 assert(not Rhythm.chain_expired(3, 0.48))
 assert(Rhythm.chain_expired(3, 0.49))
 assert(Rhythm.chain_expired(3, NAN))
 assert(Rhythm.chain_expired(3, INF))
 assert(Rhythm.chain_expired(3, -0.01))
 assert(not Rhythm.chain_expired(0, NAN))
 assert(Rhythm.next_chain(3, INF)==1)
 assert(Rhythm.confirmed_hostile_hit(true,true,100.0,85.0))
 assert(Rhythm.confirmed_hostile_hit(true,true,5.0,0.0))
 assert(not Rhythm.confirmed_hostile_hit(true,false,100.0,85.0))
 assert(not Rhythm.confirmed_hostile_hit(false,true,100.0,85.0))
 assert(not Rhythm.confirmed_hostile_hit(true,true,100.0,100.0))
 assert(not Rhythm.confirmed_hostile_hit(true,true,100.0,105.0))
 assert(not Rhythm.confirmed_hostile_hit(true,true,NAN,80.0))
 assert(Rhythm.resolved_chain(3,4,false,false)==3)
 assert(Rhythm.resolved_chain(3,4,false,true)==3)
 assert(Rhythm.resolved_chain(3,4,true,false)==0)
 assert(Rhythm.resolved_chain(3,4,true,true)==4)
 assert(Rhythm.resolved_chain(5,7,true,true)==5)
 assert(Rhythm.resolved_chain(0,1,true,true)==1)
 assert(is_equal_approx(Rhythm.posture_impact(1),12.0))
 assert(is_equal_approx(Rhythm.posture_impact(3),20.0))
 assert(is_equal_approx(Rhythm.posture_impact(5),28.0))
 assert(is_equal_approx(Rhythm.posture_impact(100),28.0))
 assert(Rhythm.chain_damage_multiplier(5, true) > Rhythm.chain_damage_multiplier(4))
 assert(Rhythm.perfect_dodge(0.1, true))
 assert(not Rhythm.perfect_dodge(0.2, true))
 assert(not Rhythm.perfect_dodge(NAN, true))
 assert(Rhythm.successful_parry(0.1, true))
 assert(not Rhythm.successful_parry(0.1, false))
 assert(not Rhythm.successful_parry(0.2, true))
 assert(is_equal_approx(Rhythm.posture_after_hit(50.0, 100.0, 20.0, true), 90.0))
 assert(Rhythm.posture_broken(100.0, 100.0))
 assert(not Rhythm.posture_broken(10.0, 0.0))
 assert(Rhythm.safe_stamina_cost(-5.0, 2) == 0.0)
 assert(Rhythm.safe_stamina_cost(20.0, 5, true) > Rhythm.safe_stamina_cost(20.0, 1))
 assert(is_equal_approx(Rhythm.POSTURE_RECOVERY_DELAY,0.5))
 assert(is_equal_approx(Rhythm.POSTURE_RECOVERY_RATE,5.0))
 assert(is_equal_approx(Rhythm.recovered_posture(50.0, 0.4),50.0))
 assert(is_equal_approx(Rhythm.recovered_posture(50.0, 0.5),50.0))
 assert(is_equal_approx(Rhythm.recovered_posture(50.0, 1.0),47.5))
 assert(is_equal_approx(Rhythm.recovered_posture(50.0, 1.5),45.0))
 assert(is_equal_approx(Rhythm.recovered_posture(50.0, 3.0),37.5))
 assert(is_equal_approx(Rhythm.recovered_posture(50.0, 4.0),32.5))
 assert(Rhythm.recovered_posture(10.0, 8.0)==0.0)
 assert(Rhythm.recovered_posture(50.0, NAN)==0.0)
 assert(Rhythm.recovered_posture(50.0, -1.0)==50.0)
 print("Combat rhythm rules: assertions passed")
 quit()
