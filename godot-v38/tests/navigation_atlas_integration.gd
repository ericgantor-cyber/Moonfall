extends SceneTree
const NAV=preload("res://scripts/systems/navigation_map.gd")
const AMERICAS=preload("res://scripts/systems/americas_wildlife_catalog.gd")
const WILDLIFE_VISUALS=preload("res://scripts/systems/americas_wildlife_visuals.gd")
const APPROVED_ART=preload("res://scripts/systems/ai_art_overrides.gd")
const WHOLE_GAME_ART=preload("res://scripts/systems/ai_art_whole_game.gd")
const AUTO_ART_QUALITY=preload("res://scripts/systems/ai_art_auto_quality.gd")
const AI_RIG_ANIMATION=preload("res://scripts/systems/ai_art_animation_runtime.gd")
var failures:int=0

func check(ok:bool,description:String)->void:
 if ok:print("PASS atlas: "+description)
 else:
  failures+=1
  print("FAIL atlas: "+description)
  push_error("FAIL atlas: "+description)

func _initialize()->void:
 call_deferred("_run")

func _run()->void:
 var map:Control=NAV.new()
 root.add_child(map)
 map.size=Vector2(300,240)
 map.call("update_navigation",Vector3(10,0,20),Vector3(10,0,-80),true)
 check(bool(map.get("has_waypoint")),"waypoint enabled")
 check(map.get("waypoint_position")==Vector3(10,0,-80),"waypoint keeps world coordinates")
 map.set("metres_per_half_width",300.0)
 check(is_equal_approx(float(map.get("metres_per_half_width")),300.0),"zoom controls map range")
 map.call("set_discovered",Array([Vector3(10,0,20)],TYPE_VECTOR3,"",null))
 check(map.get("discovered").size()==1,"visited positions render as map markers")
 map.call("update_navigation",Vector3(NAN,0,0),Vector3(INF,0,0),true)
 check(map.get("player_position")==Vector3(10,0,20) and not bool(map.get("has_waypoint")),"corrupt player and waypoint cannot poison atlas")
 map.call("update_navigation",Vector3(10,0,20),Vector3(20,0,30),true)
 check(bool(map.get("has_waypoint")) and map.get("waypoint_position")==Vector3(20,0,30),"valid waypoint recovers after invalid input")
 map.call("set_discovered",Array([Vector3(NAN,0,0),Vector3(2,0,3),Vector3(INF,0,0),Vector3(4,0,5)],TYPE_VECTOR3,"",null))
 check(map.get("discovered").size()==2,"invalid visited positions filtered")
 map.call("set_quest_markers",Array([Vector3.ZERO,Vector3(1.0e30,0,0),Vector3(10,0,10)],TYPE_VECTOR3,"",null))
 check(map.get("quest_markers").size()==2,"invalid quest locations filtered")
 var many_discoveries:Array[Vector3]=[]
 var many_quests:Array[Vector3]=[]
 for i in range(1111):
  many_discoveries.append(Vector3(float(i),0.0,0.0))
  many_quests.append(Vector3(float(i),0.0,0.0))
 map.call("set_discovered",many_discoveries)
 map.call("set_quest_markers",many_quests)
 check(map.get("discovered").size()==256 and map.get("quest_markers").size()==128,"atlas marker collections remain bounded on long sessions")
 check((map.get("discovered") as Array)[0]==Vector3(855,0,0) and (map.get("discovered") as Array)[255]==Vector3(1110,0,0),"atlas retains most recent 256 visited locations in chronological order")
 check((map.get("quest_markers") as Array)[0]==Vector3.ZERO and (map.get("quest_markers") as Array)[127]==Vector3(127,0,0),"atlas retains highest-priority quest marker ordering")

 # Storage can retain a longer validated exploration trail than the 256 UI dots.
 var exploration:Array[Vector3]=[]
 for history_index in range(3000):
  exploration.append(Vector3(float(history_index),0.0,float(history_index%29)))
 exploration.append(Vector3(NAN,0.0,0.0))
 var serialized:Array=NAV.encode_history(exploration)
 check(serialized.size()==2048,"checkpoints retain 2,048 valid discoveries without saving corrupt points")
 check(serialized[0]==[952.0,float(952%29)] and serialized.back()==[2999.0,float(2999%29)],"stored exploration retains the newest chronological discoveries")
 var reloaded:Array[Vector3]=NAV.decode_history(serialized)
 check(reloaded.size()==2048 and reloaded.front()==Vector3(952,0,952%29) and reloaded.back()==Vector3(2999,0,2999%29),"atlas history round-trips through save-shaped arrays")
 var bad_history:Array=[[NAN,2],["bad",0],[INF,1],[1.0e30,0],[7,8]]
 check(NAV.decode_history(bad_history)==[Vector3(7,0,8)],"malformed and nonfinite checkpoint locations cannot poison restored history")
 map.call("set_discovered",reloaded)
 check(map.get("discovered").size()==256,"2,048 saved discoveries render only 256 visible markers")
 check((map.get("discovered") as Array)[0]==Vector3(2744,0,2744%29) and (map.get("discovered") as Array).back()==Vector3(2999,0,2999%29),"render budget displays most recently discovered landmarks")
 # Habitat catalog validation does not allocate extra enemy physics actors.
 check(AMERICAS.HABITATS.size()==6,"Americas roster covers all six existing world regions")
 check(AUTO_ART_QUALITY.animal_limit(0,100)==0 and AUTO_ART_QUALITY.animal_limit(1,100)==50 and AUTO_ART_QUALITY.animal_limit(2,100)==100,"AI art quality scales to all nearby valid 3D models instead of three creatures")
 check(AUTO_ART_QUALITY.animation_poll_stride(2,100.0)==1 and AUTO_ART_QUALITY.animation_poll_stride(2,40.0*40.0)==2,"nearby rigs poll at full rate and far rigs reduce idle polling")
 check(AUTO_ART_QUALITY.animation_poll_stride(1,40.0*40.0)==3 and AUTO_ART_QUALITY.animation_poll_stride(0,40.0*40.0)==4,"adaptive low-quality tiers reduce distant animation work")
 check(AUTO_ART_QUALITY.should_poll_animation(0,1600.0,1,0,"attack","idle"),"combat attack transitions bypass the distant animation throttle")
 check(AUTO_ART_QUALITY.should_poll_animation(0,1600.0,1,0,"hurt","hurt"),"ongoing combat reactions retain their visual checks")
 check(not AUTO_ART_QUALITY.should_poll_animation(0,1600.0,1,0,"idle","idle") and AUTO_ART_QUALITY.should_poll_animation(0,1600.0,4,0,"idle","idle"),"unchanged distant idle clips are polled on scheduled ticks")
 check(AUTO_ART_QUALITY.should_poll_animation(0,1600.0,1,0,"death","move"),"death pose never waits for distant idle budget")
 check(AI_RIG_ANIMATION.canonical_clip("Armature|Walking_001")=="move","GLB AnimationPlayer walking aliases map to native movement")
 check(AI_RIG_ANIMATION.canonical_clip("Dragon/Attack_002")=="attack","imported skeletal attack aliases map to native combat visuals")
 check(AI_RIG_ANIMATION.canonical_clip("Take001").is_empty(),"unknown imported clips are ignored instead of driving gameplay")
 var fake_rig:=Node3D.new()
 root.add_child(fake_rig)
 var player_anim:=AnimationPlayer.new()
 fake_rig.add_child(player_anim)
 check(AI_RIG_ANIMATION.bind_imported(fake_rig).is_empty(),"unrigged imported scenes fall back safely")
 fake_rig.add_child(Skeleton3D.new())
 var animations:=AnimationLibrary.new()
 var idle_clip:=Animation.new()
 idle_clip.length=1.0
 animations.add_animation("Idle",idle_clip)
 player_anim.add_animation_library("",animations)
 var rig_binding:Dictionary=AI_RIG_ANIMATION.bind_imported(fake_rig)
 check(rig_binding.has("clips") and (rig_binding.get("clips",{}) as Dictionary).has("idle"),"real imported Skeleton3D plus AnimationPlayer is recognized")
 var fake_actor:Dictionary={"alive":true,"body":fake_rig,"attack_swing_until":3.0,"hit_react_until":0.0,"windup":0.0}
 check(AI_RIG_ANIMATION.state_for_actor(fake_actor,2.9)=="attack","original enemy attack feedback controls visual attack clip selection")
 fake_actor["hit_react_until"]=3.0
 check(AI_RIG_ANIMATION.state_for_actor(fake_actor,2.9)=="hurt","native hit reaction overrides animation attack pose")
 fake_actor["alive"]=false
 check(AI_RIG_ANIMATION.state_for_actor(fake_actor,2.9)=="death","defeated native enemies request the imported death clip")
 fake_rig.queue_free()
 check(AUTO_ART_QUALITY.chamber_limit(0,20)==0 and AUTO_ART_QUALITY.chamber_limit(1,20)==10 and AUTO_ART_QUALITY.chamber_limit(2,20)==20,"dungeon 3D art no longer has a one-monument ceiling")
 check(AUTO_ART_QUALITY.next_tier(2,3.1,0.0)==1 and AUTO_ART_QUALITY.next_tier(1,3.1,0.0)==0,"sustained slow frames downgrade high-detail art progressively")
 check(AUTO_ART_QUALITY.next_tier(0,0.0,16.1)==1 and AUTO_ART_QUALITY.next_tier(1,0.0,16.1)==2,"sustained stable frames restore high-detail art gradually")
 check(AUTO_ART_QUALITY.next_tier(1,1.5,9.0)==1 and AUTO_ART_QUALITY.quality_name(0)=="Eco","short frame-time spikes never trigger model thrashing")
 check(AUTO_ART_QUALITY.ANIMAL_EXIT_RADIUS_SQ>AUTO_ART_QUALITY.ANIMAL_ENTER_RADIUS_SQ,"AI art streamer uses hysteresis to prevent jittering 4K creature models")
 check(AUTO_ART_QUALITY.failed_load_retry_ms(1)==1800 and AUTO_ART_QUALITY.failed_load_retry_ms(2)==3600,"failed optional GLB imports back off instead of retrying each streaming tick")
 check(AUTO_ART_QUALITY.failed_load_retry_ms(6)==30000 and AUTO_ART_QUALITY.failed_load_retry_ms(100)==30000,"optional model failure retries are capped to 30 seconds")
 check(not AUTO_ART_QUALITY.can_retry_failed_load(4999,5000) and AUTO_ART_QUALITY.can_retry_failed_load(5000,5000),"failed GLB retry time honors the exact cooldown boundary")

 check(WHOLE_GAME_ART.image_path("regions","00")=="res://assets/ai_generated/regions/region_00.png","biome art paths match offline generation pipeline")
 check(WHOLE_GAME_ART.image_path("chambers","14")=="res://assets/ai_generated/chambers/chamber_14.png","room-14 mural image is available to each regional dungeon")
 check(WHOLE_GAME_ART.image_path("glyphs","orb_hud")=="res://assets/ai_generated/glyphs/glyph_orb_hud.png","original four-color orb HUD art can be optionally customized")
 check(WHOLE_GAME_ART.image_path("spells","nova")=="res://assets/ai_generated/spells/spell_nova.png","native Q spell art paths match developer art studio")
 check(WHOLE_GAME_ART.image_path("gear","boots")=="res://assets/ai_generated/gear/gear_boots.png","real equipment drops have approved art paths")
 check(WHOLE_GAME_ART.image_path("scenery","shrine")=="res://assets/ai_generated/scenery/scenery_shrine.png","waystone scenery has an approved art path")
 for invalid in [["regions","-1"],["regions","06"],["chambers","15"],["glyphs","ui_hack"],["scenery","../hero"],["heroes","z"],["gear","../../nyra"]]:
  check(WHOLE_GAME_ART.image_path(invalid[0],invalid[1]).is_empty(),"unknown, traversal and hero art slots are rejected")
 var no_art_parent:=Node3D.new()
 root.add_child(no_art_parent)
 check(WHOLE_GAME_ART.add_billboard(no_art_parent,"chambers","14",Vector3.ZERO,2.0)==null and no_art_parent.get_child_count()==0,"missing room art never creates extra nodes or colliders")
 check(WHOLE_GAME_ART.optional_texture("glyphs","nothing")==null,"unknown approved textures use game defaults")
 no_art_parent.queue_free()
 check(APPROVED_ART.animal_path("American bison")=="res://assets/ai_generated/animals/animal_american_bison.png","AI art name normalization matches the offline generator")
 check(APPROVED_ART.guardian_path(54)=="res://assets/ai_generated/guardians/guardian_54.png" and APPROVED_ART.guardian_path(55)=="","55 guardian art slots have safe bounds")
 var art_body:=CharacterBody3D.new()
 root.add_child(art_body)
 var generic_mesh:=MeshInstance3D.new()
 art_body.add_child(generic_mesh)
 generic_mesh.visible=false
 APPROVED_ART.clear_approved(art_body)
 check(generic_mesh.visible,"removing approved art restores the original animal mesh")
 check(not APPROVED_ART.attach_approved(art_body,"res://assets/ai_generated/animals/missing_test.png") and generic_mesh.visible,"missing approved image retains native wildlife and physics")
 check(art_body.get_children().size()==1 and art_body.get_child(0)==generic_mesh,"failed art lookup does not create extra gameplay actors or collision")
 art_body.queue_free()
 var fake_body:=CharacterBody3D.new()
 root.add_child(fake_body)
 for taxon in ["M","B","R","A"]:
  var silhouette:Node3D=WILDLIFE_VISUALS.attach(fake_body,taxon,"American bison" if taxon=="M" else "Wildlife")
  check(is_instance_valid(silhouette) and silhouette.get_child_count()>=2,"all four American wildlife taxa generate visible lightweight silhouettes")
  check(fake_body.get_child_count()==1,"new animal art adds no extra collision shapes or duplicate root nodes")
  WILDLIFE_VISUALS.animate(silhouette,taxon,1.0,0.2)
  for child in silhouette.get_children():
   check(child is MeshInstance3D,"wildlife embellishments are visual-only noncolliding geometry")
 fake_body.queue_free()
 check(AMERICAS.total_profiles()>=280 and AMERICAS.distinct_species_count()>=230,"Americas catalog includes hundreds of distinct real-world wildlife names")
 var archetypes:Dictionary={"wolf":true,"stag":true,"boar":true,"fox":true,"serpent":true,"panther":true,"elk":true,"owl":true}
 var taxa:Dictionary={"M":true,"B":true,"R":true,"A":true}
 for zone in range(AMERICAS.HABITATS.size()):
  var regional_profiles:Array[Dictionary]=AMERICAS.species_for_region(zone)
  check(regional_profiles.size()>=35,"each region contains many different animal profiles")
  var names_seen:Dictionary={}
  for animal in regional_profiles:
   var name:String=str(animal.get("name",""))
   check(name.length()>=3 and archetypes.has(str(animal.get("archetype",""))) and taxa.has(str(animal.get("taxon",""))),"every listed animal uses a supported native wildlife archetype")
   check(not names_seen.has(name),"animals are not duplicated within one regional habitat")
   names_seen[name]=true
 check(AMERICAS.species_for_region(-1).is_empty() and AMERICAS.species_for_region(6).is_empty(),"invalid regions cannot access wildlife tables")
 check(AMERICAS.select_for_archetype(0,"unknown",12).is_empty(),"unavailable archetypes do not fabricate animals")
 var picked:Dictionary=AMERICAS.select_for_archetype(5,"panther",17)
 check(str(picked.get("archetype",""))=="panther" and str(picked.get("name","")).length()>3,"habitat choices reuse appropriate native creature families")
 # Verify atlas contracts without running expensive procedural world startup.
 # Separate gameplay smoke suites cover scene initialization and world progression.
 var scene:PackedScene=load("res://scenes/main.tscn")
 check(scene!=null and scene.can_instantiate(),"map-enabled main scene loads")
 var source:String=FileAccess.get_file_as_string("res://scripts/native_v38_2.gd")
 check("func _toggle_atlas(" in source and "func _atlas_select_waypoint(" in source,"atlas controls remain wired")
 check('AMERICAS_WILDLIFE=preload("res://scripts/systems/americas_wildlife_catalog.gd")' in source,"native game loads the Americas catalog")
 check("func _americas_apply_wildlife_profiles()" in source and "animal[\"americas_species\"]" in source,"existing wildlife actors receive species identity without additional AI bodies")
 check("AMERICAS_VISUALS.attach(native_body" in source and "_americas_update_wildlife_visuals(delta)" in source,"native wildlife receives taxon silhouettes and live visual movement")
 check("_ai_art_upgrade_existing_glyphs()" in source and 'override_rect(v386_orb_image,"glyphs","orb_hud")' in source,"existing original HUD and art edition glyphs can use reviewed artwork")
 check("_ai_art_decorate_regions_and_chambers()" in source and 'add_billboard(room_node,"chambers"' in source,"real dungeon rooms and regions can display optional approved murals")
 check("_ai_art_build_spell_icons()" in source and 'optional_texture("spells",spell)' in source,"original Q/E/R spells acquire optional artwork without changing controls")
 check('add_billboard(node,"gear",art_kind' in source and '_create_gear_drop(at:Vector3' in source,"native loot orbs can show an approved equipment icon")
 check('override_sprite(phase_crest,"glyphs","boss_phase")' in source,"native boss phase markers reuse existing sprites")
 check('APPROVED_AI_ART.attach_approved(native_body' in source and source.find("AMERICAS_VISUALS.attach(native_body")<source.find("APPROVED_AI_ART.attach_approved(native_body"),"approved wildlife art replaces rather than doubles up the generic procedural silhouette")
 check('not visual.visible:continue' in source,"hidden placeholders skip animation when approved creature art is present")
 check("if updates>=20:break" in source and "0.28" in source and "45.0*45.0" in source,"visual motion limits scene updates to twenty nearby visible animals at a throttled cadence")
 check("func _ai_art_track_frame_performance(delta:float)" in source and "_ai_art_track_frame_performance(delta)" in source,"native world automatically adjusts imported 3D art budgets from rolling frame time")
 check("AI_ART_AUTO_QUALITY.animal_limit(ai_art_quality_tier,candidates.size())" in source and "AI_ART_AUTO_QUALITY.chamber_limit(ai_art_quality_tier,rooms.size())" in source,"both wildlife and dungeon 3D detail obey scalable auto-quality budgets")
 check("MIN_LOAD_INTERVAL_MS" in source and "loaded_this_tick" in source and "ai_art_next_model_load_ms" in source,"one-time-sliced 3D asset loading avoids sudden GPU spikes")
 check("AI_ART_ANIMATION.bind_imported(current)" in source and "AI_ART_ANIMATION.apply_state" in source,"nearby animals use imported rig animations without changing native movement or damage")
 check('guardian["ai_art_animation_binding"]' in source,"approved guardian GLB rigs can play the same native combat states")
 check("ANIMAL_EXIT_RADIUS_SQ" in source and "ROOM_EXIT_RADIUS_SQ" in source,"art LOD retains nearby active actors beyond initial spawn radius")
 check("body.global_position.distance_squared_to(player.global_position)" in source and "not body.visible" in source,"visual embellishments are culled with existing native animal visibility")
 check("american_wildlife_visual_ticks+=updates" in source,"wildlife animation performance samples can be inspected")
 check("americas_wildlife_eligible" in source and "if bool(animal.get(\"boss\",false))" in source,"native bosses are not overwritten by new wildlife identity")
 check('data["americas_wildlife_rolls"]' in source and 'extras.get("americas_wildlife_rolls",[])' in source,"wildlife identities persist across saved adventures")
 check("saved_american_rolls.size()==REGIONS.size()" in source and "valid_wildlife=false" in source,"corrupt wildlife offsets cannot poison checkpoint loads")
 check("which!=\"Bestiary\"" in source and "AMERICAS_WILDLIFE.distinct_species_count()" in source,"all curated wildlife profiles are browsable within existing Bestiary menu")
 check("func _atlas_zoom(" in source,"atlas zoom handler exists")
 check("NAVIGATION_MAP.encode_history(atlas_discovered)" in source and "NAVIGATION_MAP.decode_history(extras.get(" in source,"exploration checkpoint history is saved and restored")
 check("func atlas_set_quest_destination(" in source,"quest map targets remain supported")
 check("atlas_chamber_scan_elapsed+=maxf(0.0,delta)" in source and "_atlas_record_nearby_chambers(here)" in source,"closed-map chamber scanning runs in the world update")
 check("func _atlas_record_nearby_chambers(" in source and "chamber_id in atlas_chambers_seen" in source,"nearby chambers discovered once")
 check("atlas_chambers_seen" in source and "NAVIGATION_MAP.decode_chambers(" in source,"checkpoint saves and restores chamber progress")
 check("_atlas_room_id(site_id,stage)" in source and "v321_annexes.size()" in source,"checkpoint retains original chamber IDs and saves annex discoveries")
 check("This dungeon: %d/14" in source and "range(1,15)" in source,"atlas tracks fourteen rooms within each active rift")
 check("atlas_regional_seen" in source and "_atlas_regional_room_id(" in source,"regional dungeon discoveries have independent saved room IDs")
 check("DiscoveredDungeonDestinations" in source and "DiscoveredDungeonFastTravel" in source and "atlas_fast_travel_button.pressed.connect(_atlas_fast_travel_to_selected)" in source,"atlas contains discovered-dungeon fast travel selector and action")
 check("atlas_regional_seen.has(room_id)" in source and "_atlas_regional_room_id(zone,dungeon_id,1)" in source,"only discovered stage-one entrances appear as fast-travel destinations")
 check("not atlas_regional_seen.has(_atlas_regional_room_id(zone,dungeon_id,1))" in source,"travel rechecks entrance discovery even after selecting destination")
 check("_combat_threat()" in source and "not mounted" in source and "not death_active" in source and "not menu_open" in source,"fast travel gates combat, mounted state, death, and menus")
 check("player.global_position=entrance+Vector3(0,1.25,0)" in source and "(player as CharacterBody3D).velocity=Vector3.ZERO" in source,"teleport lands above real collidable entrance and resets velocity")
 check("atlas_panel.visible=false" in source and "atlas_regional_dungeon=destination_id" in source,"fast travel closes atlas and enters the correct independent dungeon")
 check("atlas_fast_travel_unlocked_cache" in source and "if unlocked!=atlas_fast_travel_unlocked_cache:" in source,"fast travel dropdown only rebuilds when discovery changes, preserving keyboard selection")
 check("atlas_fast_travel_select.focus_mode=Control.FOCUS_ALL" in source,"destination dropdown is available to keyboard focus")
 check("DungeonDiscoveryProgress" in source and "Dungeons discovered: %d / %d" in source,"atlas shows total discovered dungeons and travel instructions")
 check("func _atlas_discovered_entrance_markers()" in source and "map_markers.append_array(_atlas_discovered_entrance_markers())" in source,"world atlas displays discovered dungeon entrances as physical coordinate markers")
 check("if atlas_dungeon_site<0 and atlas_regional_dungeon<0" in source,"discovered dungeon world markers cannot clutter a specific dungeon interior floor plan")
 check("atlas_fast_travel_unlocked_cache.clear()" in source,"fast travel selector cache resets across adventures and checkpoint restore")
 var discovered_travel_ids:Array[int]=NAV.decode_chambers([0,13,14,27,419,420],420)
 check(discovered_travel_ids==[0,13,14,27,419],"entrance visit unlocks persist while corrupted IDs remain locked")
 check(not discovered_travel_ids.has(28),"unvisited entrance stays locked despite discovering other chambers")
 check("atlas_regional_seen=NAVIGATION_MAP.decode_chambers(" in source,"new regional discoveries are strictly validated on checkpoint restore")
 check("atlas_regional_trail_key" in source and "_atlas_regional_rooms()" in source,"regional dungeon trail keys and floors stay isolated from original rift history")
 check("v321_region_room_passages" in source and "start_known and end_known" in source,"independent dungeon internal corridors are drawn from physical geometry with exploration fog")
 check("REGION %d | DUNGEON %d / 5 | 14 ROOMS" in source,"map identifies which independent dungeon is being explored")
 check("for entry in v321_region_rooms" in source and "var next_regional:int=-1" in source,"atlas selects the physical regional dungeon rather than joining separate sites")
 check(NAV.decode_chambers([0,13,14,419,420,-1],420)==[0,13,14,419],"regional dungeon checkpoint data supports all 420 chambers without accepting invalid IDs")
 check("all_passages.append_array(v321_annex_passages)" in source and "start_known and end_known" in source,"atlas displays real annex bridges with exploration fog")
 check("RiftAnnexFloor" in source and "_atlas_all_site_chambers()" in source,"atlas reads actual fourteen-room geometry")
 check("nearest_distance" in source,"atlas stays in dungeon view around distant annex rooms")
 check(NAV.decode_chambers([0,8,9,19,41,42,-1],42)==[0,8,9,19,41],"checkpoint filters new and old chamber IDs safely")
 check(NAV.decode_chambers([0,3,3,8,-1,9,"7",NAN],9)==[0,3,8],"chamber checkpoint filters duplicates and invalid IDs")
 check(NAV.decode_chambers([],9).is_empty(),"legacy saves without chamber discoveries still load")
 var chamber_marks:Array[Vector3]=[]
 for chamber_index in range(120):
  chamber_marks.append(Vector3(float(chamber_index),0.0,0.0))
 chamber_marks[5]=Vector3(NAN,0.0,0.0)
 map.call("set_chamber_markers",chamber_marks)
 check((map.get("discovered_chambers") as Array).size()==64,"authored chamber markers have a bounded render budget")
 check((map.get("discovered_chambers") as Array)[5]==Vector3(6,0,0),"invalid chamber map coordinates are discarded")
 var trail_source:String=FileAccess.get_file_as_string("res://scripts/systems/navigation_map.gd")
 check("MAX_TRAIL_SEGMENT_METRES" in trail_source and "draw_line(centre+previous" in trail_source,"exploration markers connect into bounded route trail")
 check("discovered_chambers" in trail_source and "draw_arc(chamber_screen" in trail_source,"discovered chambers have distinct map icons")
 check("set_chamber_markers" in source and "_atlas_chamber_marker_positions()" in source,"game publishes discovered authored chamber positions to atlas")
 check("TEAL: EXPLORED TRAIL" in source,"map legend explains trails and chambers")

 var dungeon_anchors:Array[Vector3]=[Vector3(0,0,0),Vector3(250,0,0)]
 check(NAV.dungeon_site_at(Vector3(10,0,0),dungeon_anchors,-1)==0,"entering a rift area automatically selects dungeon map")
 check(NAV.dungeon_site_at(Vector3(30,0,0),dungeon_anchors,0)==0,"dungeon view stays stable near boundary")
 check(NAV.dungeon_site_at(Vector3(48,0,0),dungeon_anchors,0)==-1,"leaving the dungeon returns to world map")
 check(NAV.dungeon_site_at(Vector3(248,0,0),dungeon_anchors,-1)==1,"other dungeon sites select independently")
