extends SceneTree
const R=preload("res://scripts/systems/guardian_attack_rules.gd")
var failures:int=0
func check(value:bool,label:String)->void:
 if value:print("PASS guardian: "+label)
 else:failures+=1;push_error("FAIL guardian: "+label)
func _initialize()->void:call_deferred("_run")
func _run()->void:
 check(R.pattern_count(1)==2,"phase one has two attacks")
 check(R.pattern_count(2)==3,"phase two has three attacks")
 check(R.pattern_count(3)==4,"phase three has four attacks")
 check(R.next_pattern(3,3)==0,"phase three wraps")
 check(R.next_pattern_after_phase_change(1,2)==2,"phase two introduces precision after sweep")
 check(R.next_pattern_after_phase_change(2,3)==3,"phase three introduces delayed strike after precision")
 check(R.next_pattern_after_phase_change(3,3)==0,"phase transition selection wraps safely")
 check(R.unlocked_patterns(1)==[0,1],"phase one starts with focused and sweep patterns")
 check(R.unlocked_patterns(2)==[0,1,2],"phase two unlocks precision pattern")
 check(R.unlocked_patterns(3)==[0,1,2,3],"phase three unlocks delayed strike")
 check(not R.pattern_unlocked(3,1) and R.pattern_unlocked(3,3),"advanced attacks stay phase-gated")
 check(R.pattern_index(-1,3)==3,"warning reports last selected attack")
 check(R.radius(1)>R.radius(2),"wide sweep larger than precision")
 check(R.windup(3,1.25)>=0.75,"late boss phases retain dodge window")
 var behavior=load("res://scripts/systems/gameplay_v313.gd")
 check(behavior.choose_boss_pattern(3,100.0,100.0,2,3.0,0,false,1)==3,"precision miss leads to delayed strike")
 check(behavior.choose_boss_pattern(3,20.0,100.0,2,3.0,0,false,1)==0,"low health cancels combo")
 check(behavior.choose_boss_pattern(2,100.0,100.0,2,3.0,0,false,1)!=3,"delayed combo phase gated")
 var enemy_rules=load("res://scripts/systems/enemy_combat_rules.gd")
 check(is_equal_approx(enemy_rules.staggered_cooldown("wolf",0),1.35),"first wolf keeps base cadence")
 check(enemy_rules.staggered_cooldown("wolf",1)>enemy_rules.staggered_cooldown("wolf",0),"nearby enemy IDs get offset cooldowns")
 check(is_equal_approx(enemy_rules.staggered_cooldown("wolf",4),enemy_rules.staggered_cooldown("wolf",0)),"swarm offsets remain bounded")
 var ai=load("res://scripts/systems/ai_rules.gd")
 var lane_zero:Vector3=ai.approach(Vector3(5,0,0),4.0,0,false,1,5.0)
 var lane_two:Vector3=ai.approach(Vector3(5,0,0),4.0,2,false,1,5.0)
 check(lane_zero.distance_to(lane_two)>0.1,"pack members choose distinct flanking lanes")
 check(is_equal_approx(lane_zero.length(),4.0),"flanking preserves movement speed")
 check(ai.approach(Vector3(1,0,0),4.0,2,false,1,1.5).z!=0.0,"approaching enemy retains slight flank before melee")
 check(is_equal_approx(ai.approach(Vector3(1,0,0),4.0,2,false,1,1.0).z,0.0),"flanking fades at striking distance")
 check(is_equal_approx(ai.approach(Vector3(1,0,0),4.0,2,false,1,1.0).length(),4.0),"melee closing movement retains speed")
 check(ai.approach(Vector3(5,0,0),4.0,0,true,1,5.0).z==0.0,"boss movement does not inherit pack flanking")
 check(enemy_rules.group_attack_ready(0.0,0),"first enemy can use first attack slot")
 check(not enemy_rules.group_attack_ready(0.0,1),"other enemies wait for their attack slot")
 check(enemy_rules.group_attack_ready(0.25,1),"second enemy receives the next slot")
 check(not enemy_rules.group_attack_ready(INF,1),"invalid time prevents attacks")
 check(enemy_rules.group_attack_ready(1000000000000.0,0),"attack slots remain valid in long sessions")
 check(enemy_rules.group_attack_ready(1000000000000.25,1),"next slot remains valid in long sessions")
 check(enemy_rules.group_attack_ready(0.0,3,1),"single-slot fallback allows all enemies")
 check(enemy_rules.role_attack_ready("wolf",0.0,0),"ambusher gets assigned slot")
 check(not enemy_rules.role_attack_ready("wolf",0.25,0),"ambusher waits outside assigned slot")
 check(enemy_rules.role_attack_ready("boar",0.0,0),"bruiser gets standard slot")
 check(enemy_rules.role_attack_ready("boar",0.75,0),"bruiser gets second slot")
 var ambush:Vector3=ai.approach(Vector3(5,0,0),4.0,0,false,1,5.0,"ambusher")
 var bruiser:Vector3=ai.approach(Vector3(5,0,0),4.0,0,false,1,5.0,"bruiser")
 var peaceful:Vector3=ai.approach(Vector3(5,0,0),4.0,0,false,1,5.0,"passive")
 check(absf(ambush.z)>absf(bruiser.z),"ambushers flank wider than bruisers")
 check(is_equal_approx(peaceful.z,0.0),"passive animals do not flank")
 check(is_equal_approx(bruiser.length(),4.0),"bruisers preserve movement speed")
 check(is_equal_approx(ai.approach(Vector3(5,9,0),4.0,0,true,1,5.0).y,0.0),"boss pursuit remains on ground plane")
 check(ai.approach(Vector3(1.0e30,0,1.0e30),4.0,0,false,1,5.0)==Vector3.ZERO,"extreme movement vectors fail closed")
 check(enemy_rules.preferred_spacing("wolf")>enemy_rules.preferred_spacing("boar"),"ambushers keep wider spacing")
 check(enemy_rules.wants_flank("wolf",4.0,true),"wolf can flank at mid range")
 check(not enemy_rules.wants_flank("wolf",4.0,false),"flanking needs visibility")
 check(not enemy_rules.should_circle("wolf","strafe",2.0),"ambushers close inside preferred spacing")
 check(not enemy_rules.wants_flank("boar",4.0,true),"bruisers avoid ambusher flanking")
 check(enemy_rules.attack_window_count("wolf")==4,"ambusher uses four turn slots")
 check(enemy_rules.attack_window_count("boar")==6,"bruiser uses six turn slots")
 check(enemy_rules.tactical_attack_ready("wolf",0.0,0),"ambusher attacks on its turn")
 check(not enemy_rules.tactical_attack_ready("wolf",0.25,0),"ambusher waits between turns")
 check(enemy_rules.tactical_attack_ready("boar",0.25,0),"bruiser gets its second opportunity")
 check(not enemy_rules.tactical_attack_ready("boar",INF,0),"invalid time cannot create attack turn")
 check(ai.retreat_due(30.0,100.0,false,-1,10.0,0.0,"ambusher"),"wounded ambusher withdraws")
 check(not ai.retreat_due(30.0,100.0,false,-1,10.0,0.0,"bruiser"),"bruiser holds position at 30 percent health")
 check(ai.retreat_due(15.0,100.0,false,-1,10.0,0.0,"bruiser"),"severely wounded bruiser retreats")
 check(not ai.retreat_due(15.0,100.0,true,-1,10.0,0.0,"ambusher"),"guardian never uses wildlife retreat")
 check(not ai.retreat_due(15.0,100.0,false,1,10.0,0.0,"ambusher"),"dungeon enemies do not flee")
 check(not ai.retreat_due(15.0,100.0,false,-1,10.0,15.0,"ambusher"),"retreat cooldown stays enforced")
 check(load("res://scenes/main.tscn")!=null,"whole Moonfall scene loads")
 quit(1 if failures else 0)
