{
  "name": "moonfall-desktop",
  "version": "7.6.0",
  "private": true,
  "description": "Moonfall 2.5D Windows desktop game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "npm run prepare:modular && electron-builder --win nsis --x64",
    "prepare:modular": "node modularize.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.moonfall.game",
    "productName": "Moonfall",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "game.html",
      "node_modules/three/build/three.module.js",
      "modular/**/*",
      "modularize.js",
      "boss-phases.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moonfall",
      "artifactName": "Moonfall-${version}-Windows-Setup.${ext}"
    }
  },
  "dependencies": {
    "three": "0.160.1"
  }
}
