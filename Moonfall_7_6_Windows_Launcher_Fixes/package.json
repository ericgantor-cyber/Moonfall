{
  "name": "moonfall-desktop",
  "version": "7.6.0",
  "private": true,
  "description": "Moonfall 2.5D Windows desktop game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "npm run prepare:modular && npm run build:dx12 && electron-builder --win nsis --x64",
    "prepare:modular": "node modularize.js",
    "build:dx12": "cmake -S ../native/dx12-prototype -B ../native/dx12-prototype/build -G \"Visual Studio 17 2022\" -A x64 && cmake --build ../native/dx12-prototype/build --config Release --parallel"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.moonfall.game",
    "productName": "Moonfall",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "dx12-launch.js",
      "gpu-support.js",
      "direct3d-backend.js",
      "node_modules/three/build/three.module.js",
      "modular/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moonfall",
      "artifactName": "Moonfall-${version}-Windows-Setup.${ext}"
    },
    "extraResources": [
      {
        "from": "../native/dx12-prototype/build/Release/MoonfallDX12Prototype.exe",
        "to": "dx12/MoonfallDX12Prototype.exe"
      }
    ]
  },
  "dependencies": {
    "three": "0.160.1"
  }
}
