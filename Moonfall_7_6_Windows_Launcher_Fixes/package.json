{
  "name": "moonfall-desktop",
  "version": "9.7.0",
  "private": true,
  "description": "Moonfall 2.5D Windows desktop game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "npm run prepare:modular && node prepare-dx12-heroes.js && npm run build:dx12 && electron-builder --win nsis --x64",
    "prepare:modular": "node modularize.js",
    "build:dx12": "cmake -S ../native/dx12-prototype -B ../native/dx12-prototype/build -G \"Visual Studio 17 2022\" -A x64 && cmake --build ../native/dx12-prototype/build --config Release --parallel"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.moonfall.game",
    "productName": "Moonfall",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "dx12-launch.js",
      "gpu-support.js",
      "direct3d-backend.js",
      "node_modules/three/build/three.module.js",
      "modular/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moonfall",
      "artifactName": "Moonfall-${version}-Windows-Setup.${ext}"
    },
    "extraResources": [
      {
        "from": "../native/dx12-prototype/build/Release/MoonfallDX12Prototype.exe",
        "to": "dx12/MoonfallDX12Prototype.exe"
      },
      {
        "from": "../native/dx12-prototype/build/Release/hero-z.png",
        "to": "dx12/hero-z.png"
      },
      {
        "from": "../native/dx12-prototype/build/Release/hero-nyra.png",
        "to": "dx12/hero-nyra.png"
      },
      {
        "from": "../native/dx12-prototype/build/Release/original-hero-art.json",
        "to": "dx12/original-hero-art.json"
      },
      {
        "from": "../native/dx12-prototype/build/Release/enemy-bear.png",
        "to": "dx12/enemy-bear.png"
      },
      {
        "from": "../native/dx12-prototype/build/Release/enemy-creep-1.png",
        "to": "dx12/enemy-creep-1.png"
      },
      {
        "from": "../native/dx12-prototype/build/Release/enemy-creep-2.png",
        "to": "dx12/enemy-creep-2.png"
      },
      {
        "from": "../native/dx12-prototype/build/Release/enemy-creep-3.png",
        "to": "dx12/enemy-creep-3.png"
      },
      {
        "from": "../native/dx12-prototype/build/Release/boss-titan-fire.png",
        "to": "dx12/boss-titan-fire.png"
      },
      {
        "from": "../native/dx12-prototype/build/Release/boss-titan-nature.png",
        "to": "dx12/boss-titan-nature.png"
      }
    ]
  },
  "dependencies": {
    "three": "0.160.1"
  }
}
